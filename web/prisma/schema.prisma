/// Durable command for dispatching one concrete queue job. Domain events are
/// published through OutboxEvent so the two retry loops have separate ownership.
model OperationEnqueueIntent {
  id           String    @id @default(cuid())
  shop         String
  queueRoutingKey String @map("queueKey")
  queueJobName    String @map("jobName")
  payload      Json
  payloadByteSize Int
  payloadHash String @db.Char(64)
  payloadSchemaVersion Int @default(1)
  payloadCompression String? @db.VarChar(24)
  payloadStorageKey String? @db.VarChar(1024)
  options      Json?
  dispatchScope String @default("LEGACY") @db.VarChar(120)
  dispatchDedupeKey String? @map("dedupeKey") @db.VarChar(512)
  status       OperationEnqueueIntentStatus @default(PENDING)
  dispatchAttemptCount Int @default(0) @map("attempts")
  lastError    String?
  nextAttemptAt DateTime @default(now())
  dispatchedAt DateTime?
  dispatchStartedAt DateTime?
  dispatchHeartbeatAt DateTime?
  dispatchLeaseExpiresAt DateTime?
  dispatchOwnerId String? @map("dispatchOwner")
  dispatchClaimToken String?
  dispatchFencingToken BigInt @default(0)
  lastErrorCode String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  retentionUntil DateTime? @default(dbgenerated("(now() + interval '90 days')"))
  redactedAt DateTime?

  @@unique([shop, dispatchDedupeKey])
  @@index([shop, status, nextAttemptAt, id])
  @@index([status, nextAttemptAt, id])
  @@index([status, dispatchLeaseExpiresAt, id])
}

/// Terminal queue/job delivery failures. Per-record bulk mutation failures are
/// stored in DeadLetterChange and have an independent recovery workflow.
model DeadLetterJob {
  id         String    @id @default(cuid())
  shop       String?
  queueName    String
  queueJobName String? @map("jobName")
  queueJobId   String? @map("jobId")
  payload    Json?
  error      String?
  attempts   Int
  failedAt   DateTime  @default(now())
  resolvedAt DateTime?
  resolution DeadLetterResolution?

  @@index([shop, failedAt])
  @@index([queueName, failedAt])
  @@index([resolvedAt, failedAt])
}

