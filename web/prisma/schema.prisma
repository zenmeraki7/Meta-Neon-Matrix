generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  shop                        String
  id                          String
  mirrorBatchId               String
  title                       String
  handle                      String?
  status                      String
  statusNormalized            ShopifyProductStatus     @default(UNKNOWN)
  productType                 String?
  vendor                      String?
  tags                        String[]
  templateSuffix              String?

  // split raw html from filterable text
  descriptionHtml             String?
  descriptionText             String?

  createdAt                   DateTime?
  updatedAt                   DateTime?
  publishedAt                 DateTime?
  seoTitle                    String?
  seoDescription              String?
  totalInventory              Int?
  categoryId                  String?
  categoryName                String?
  googleShoppingEnabled       Boolean?
  googleShoppingAgeGroup      String?
  googleShoppingCategory      String?
  googleShoppingColor         String?
  googleShoppingCondition     String?
  googleShoppingCustomLabel0  String?
  googleShoppingCustomLabel1  String?
  googleShoppingCustomLabel2  String?
  googleShoppingCustomLabel3  String?
  googleShoppingCustomLabel4  String?
  googleShoppingCustomProduct Boolean?
  googleShoppingGender        String?
  googleShoppingMpn           String?
  googleShoppingMaterial      String?
  googleShoppingSize          String?
  googleShoppingSizeSystem    String?
  googleShoppingSizeType      String?
  categoryAgeGroup            String?
  categoryColor               String?
  categoryFabric              String?
  categoryFit                 String?
  categorySize                String?
  categoryTargetGender        String?
  categoryWaistRise           String?
  featuredImageUrl            String?
  featuredImageAltText        String?
  optionsJson                 Json?
  collectionsJson             Json?
  option1Name                 String?
  option2Name                 String?
  option3Name                 String?
  variantCount                Int?      @default(0)
  visibleOnlineStore          Boolean?
  lastSourceUpdatedAt         DateTime?
  lastSourceEventAt           DateTime?
  lastSourceKind              String?
  lastReconciledAt            DateTime?
  variants                    Variant[]

  @@id([shop, id, mirrorBatchId])
  @@index([shop, mirrorBatchId])
  @@index([shop, status])
  @@index([shop, statusNormalized])
  @@index([shop, vendor])
  @@index([shop, productType])
  @@index([shop, title])
  @@index([shop, handle])
  @@index([shop, createdAt])
  @@index([shop, updatedAt])
  @@index([shop, publishedAt])
  @@index([shop, categoryName])
  @@index([shop, googleShoppingEnabled])
  @@index([shop, googleShoppingCategory])
  @@index([shop, googleShoppingCondition])
  @@index([shop, googleShoppingGender])
  @@index([shop, googleShoppingAgeGroup])
  @@index([shop, categoryColor])
  @@index([shop, categorySize])
  @@index([shop, categoryTargetGender])
  @@index([shop, templateSuffix])
  @@index([shop, option1Name])
  @@index([shop, option2Name])
  @@index([shop, option3Name])
  @@index([shop, variantCount])
  @@index([shop, visibleOnlineStore])
  @@index([shop, lastReconciledAt])
  @@index([shop, lastSourceEventAt])
  @@index([shop, lastSourceKind])
  @@index([shop, lastSourceUpdatedAt])
  @@index([shop, mirrorBatchId, categoryAgeGroup])
  @@index([shop, mirrorBatchId, categoryColor])
  @@index([shop, mirrorBatchId, categoryFabric])
  @@index([shop, mirrorBatchId, categoryFit])
  @@index([shop, mirrorBatchId, categoryName])
  @@index([shop, mirrorBatchId, categorySize])
  @@index([shop, mirrorBatchId, categoryTargetGender])
  @@index([shop, mirrorBatchId, categoryWaistRise])
  @@index([shop, mirrorBatchId, googleShoppingCategory])
  @@index([shop, mirrorBatchId, googleShoppingColor])
  @@index([shop, mirrorBatchId, googleShoppingCustomLabel0])
  @@index([shop, mirrorBatchId, googleShoppingCustomLabel1])
  @@index([shop, mirrorBatchId, googleShoppingCustomLabel2])
  @@index([shop, mirrorBatchId, googleShoppingCustomLabel3])
  @@index([shop, mirrorBatchId, googleShoppingCustomLabel4])
  @@index([shop, mirrorBatchId, googleShoppingMaterial])
  @@index([shop, mirrorBatchId, googleShoppingMpn])
  @@index([shop, mirrorBatchId, googleShoppingSize])
  @@index([shop, mirrorBatchId, option1Name])
  @@index([shop, mirrorBatchId, option2Name])
  @@index([shop, mirrorBatchId, option3Name])
  @@index([shop, mirrorBatchId, productType])
  @@index([shop, mirrorBatchId, vendor])
  @@index([shop, mirrorBatchId, status])
  @@index([shop, mirrorBatchId, statusNormalized])
  @@index([shop, mirrorBatchId, totalInventory])
  @@index([shop, mirrorBatchId, title, id])
  @@index([shop, mirrorBatchId, handle, id])
  @@index([shop, mirrorBatchId, createdAt, id])
  @@index([shop, mirrorBatchId, updatedAt, id])
  @@index([shop, mirrorBatchId, publishedAt, id])
  @@index([shop, mirrorBatchId, visibleOnlineStore])
  @@index([shop, mirrorBatchId, variantCount])
  @@index([shop, mirrorBatchId, templateSuffix])

  // add this because search/filter now uses descriptionText
  @@index([shop, mirrorBatchId, descriptionText])
}

enum ShopifyProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
  UNKNOWN
}

model Variant {
  shop                String
  id                  String
  productId           String
  mirrorBatchId       String
  inventoryItemId     String?
  title               String?
  sku                 String?
  barcode             String?
  price               Decimal? @db.Decimal(20, 6)
  compareAtPrice      Decimal? @db.Decimal(20, 6)
  inventoryQuantity   Int?
  inventoryPolicy     String?
  taxable             Boolean?
  taxCode             String?
  position            Int?
  selectedOptionsJson Json?
  cost                Decimal? @db.Decimal(20, 6)
  countryOfOrigin     String?
  hsTariffCode        String?
  weight              Float?
  weightUnit          String?
  option1Value        String?
  option2Value        String?
  option3Value        String?
  physicalProduct     Boolean?
  profitMargin        Float?
  tracked             Boolean?
  product             Product  @relation(fields: [shop, productId, mirrorBatchId], references: [shop, id, mirrorBatchId])

  @@id([shop, id, mirrorBatchId])
  @@index([shop, mirrorBatchId])
  @@index([shop, sku])
  @@index([shop, price])
  @@index([shop, productId])
  @@index([shop, barcode])
  @@index([shop, title])
  @@index([shop, compareAtPrice])
  @@index([shop, cost])
  @@index([shop, inventoryQuantity])
  @@index([shop, inventoryPolicy])
  @@index([shop, taxable])
  @@index([shop, weight])
  @@index([shop, weightUnit])
  @@index([shop, countryOfOrigin])
  @@index([shop, hsTariffCode])
  @@index([shop, option1Value])
  @@index([shop, option2Value])
  @@index([shop, option3Value])
  @@index([shop, tracked])
  @@index([shop, physicalProduct])
  @@index([shop, profitMargin])
  @@index([shop, mirrorBatchId, countryOfOrigin])
  @@index([shop, mirrorBatchId, inventoryPolicy])
  @@index([shop, mirrorBatchId, option1Value])
  @@index([shop, mirrorBatchId, option2Value])
  @@index([shop, mirrorBatchId, option3Value])
  @@index([shop, mirrorBatchId, productId, option1Value])
  @@index([shop, mirrorBatchId, productId, option2Value])
  @@index([shop, mirrorBatchId, productId, option3Value])
  @@index([shop, mirrorBatchId, weightUnit])
  @@index([shop, mirrorBatchId, sku])
  @@index([shop, mirrorBatchId, barcode])
  @@index([shop, mirrorBatchId, productId])
  @@index([shop, mirrorBatchId, inventoryItemId])
  @@index([shop, mirrorBatchId, price])
  @@index([shop, mirrorBatchId, compareAtPrice])
  @@index([shop, mirrorBatchId, inventoryQuantity])
  @@index([shop, mirrorBatchId, taxable])
  @@index([shop, mirrorBatchId, tracked])
  @@index([shop, mirrorBatchId, physicalProduct])
  @@index([shop, mirrorBatchId, position])
  @@index([shop, mirrorBatchId, productId, position])
}

model Shop {
  id              String   @id
  shopifyDomain   String   @unique @map("shopify_domain")
  scope           String
  plan            String   @default("free")
  active          Boolean  @default(true)
  installedAt     DateTime @default(now()) @map("installed_at")
  uninstalledAt   DateTime? @map("uninstalled_at")
  lastSyncedAt    DateTime? @map("last_synced_at")

  variantMetafields VariantMetafield[]
  bulkEditSessions  BulkEditSession[]
  bulkEditChanges   BulkEditChange[]
  syncCursors       SyncCursor[]

  @@map("shops")
}

model VariantMetafield {
  id                 BigInt      @id @default(autoincrement())
  shopId             String      @map("shop_id")
  variantId          BigInt      @map("variant_id")
  shopifyMetafieldId String?     @map("shopify_metafield_id")
  namespace          String
  key                String
  type               String?
  value              String?
  pendingValue       String?     @map("pending_value")
  compareDigest      String?     @map("compare_digest")
  shopifyVersion     BigInt      @default(0) @map("shopify_version")
  editStatus         EditStatus  @default(SYNCED) @map("edit_status")
  isDirty            Boolean     @default(false) @map("is_dirty")
  lastEditedAt       DateTime?   @map("last_edited_at")
  lastSyncedAt       DateTime?   @map("last_synced_at")

  shop               Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@index([variantId, namespace, key])
  @@index([shopId, isDirty])
  @@unique([shopId, variantId, namespace, key])
  @@map("variant_metafields")
}

model DeadLetterChange {
  id             String   @id @db.Uuid
  originalChange Json     @map("original_change")
  errorCode      String   @map("error_code")
  failedAt       DateTime @default(now()) @map("failed_at")
  shopId         String   @map("shop_id")
  notified       Boolean  @default(false)

  @@index([shopId, failedAt])
  @@index([notified])
  @@map("dead_letter_changes")
}

model BulkEditSession {
  id           String        @id @default(uuid()) @db.Uuid
  shopId       String        @map("shop_id")
  status       SessionStatus @default(DRAFT)
  filterParams Json          @default("{}") @map("filter_params")
  variantCount Int           @default(0) @map("variant_count")
  changeCount  Int           @default(0) @map("change_count")
  writtenCount Int           @default(0) @map("written_count")
  errorCount   Int           @default(0) @map("error_count")
  completedAt  DateTime?     @map("completed_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  shop      Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  changes   BulkEditChange[]

  @@map("bulk_edit_sessions")
}

model BulkEditChange {
  id                 String           @id @default(uuid()) @db.Uuid
  sessionId          String           @map("session_id") @db.Uuid
  shopId             String           @map("shop_id")
  variantId          BigInt           @map("variant_id")
  definitionId       String?          @map("definition_id") @db.Uuid
  shopifyOwnerId     String           @map("shopify_owner_id")
  fieldName          String           @map("field_name")
  namespace          String
  key                String
  type               String?
  oldValue           String?          @map("old_value")
  newValue           String?          @map("new_value")
  compareDigest      String?          @map("compare_digest")
  status             ChangeStatus     @default(PENDING)
  attemptCount       Int              @default(0) @map("attempt_count")
  shopifyError       String?          @map("shopify_error")
  retryable          Boolean          @default(true)
  writingStartedAt   DateTime?        @map("writing_started_at")
  appliedAt          DateTime?        @map("applied_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  session            BulkEditSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  shop               Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([sessionId, variantId, namespace, key])
  @@index([shopId, sessionId, status])
  @@index([shopId, status, writingStartedAt])
  @@map("bulk_edit_changes")
}

model SyncCursor {
  id            BigInt    @id @default(autoincrement())
  shopId        String    @map("shop_id")
  resourceType  String    @map("resource_type")
  cursorValue   String?   @map("cursor_value")
  lastSyncedAt  DateTime? @map("last_synced_at")

  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, resourceType])
  @@map("sync_cursors")
}

model SpreadsheetFile {
  id             String   @id @default(cuid())
  shop           String
  editHistoryId  String?
  operationType  String?
  operationId    String?
  status         String   @default("UPLOADED")
  originalFilename String?
  storageKey     String?
  checksum       String?
  rowParseErrorCount Int? @default(0)
  validatedAt    DateTime?
  fileUrl        String?
  columnMappings Json?
  totalRows      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shop])
  @@index([shop, editHistoryId])
  @@index([shop, operationType, operationId])
}

model Store {
  id                              String            @id @default(cuid())
  shopUrl                         String            @unique
  shopEmail                       String
  accessToken                     String?
  accessTokenEncrypted            String?
  accessTokenKeyVersion           String?
  activeMirrorBatchId             String?
  activeCollectionBatchId         String?
  isCollectionSyncing             Boolean           @default(false)
  lastCollectionSyncAt            DateTime?
  isProductTypeSyncing            Boolean           @default(false)
  lastProductTypeSyncAt           DateTime?
  isProductInitialySyning         Boolean           @default(false)
  productInitialSyncProgress      Int               @default(0)
  syncProgressStage               SyncProgressStage @default(IDLE)
  shopifyBulkJobCompleted         Boolean           @default(false)
  storeTotalProducts              Int               @default(0)
  isProductSyncing                Boolean           @default(false)
  lastProductSyncAt               DateTime?
  lastProductSyncAttemptAt        DateTime?
  lastProductSyncSubmittedAt      DateTime?
  productSyncStartedAt            DateTime?
  productSyncRecoveryRequired     Boolean           @default(false)
  mirrorHealthState               MirrorHealthState @default(HEALTHY)
  staleReason                     String?
  repairRequired                  Boolean           @default(false)
  lastFullSyncAt                  DateTime?
  lastIncrementalSyncAt           DateTime?
  lastWebhookProcessedAt          DateTime?
  lastReconcileAt                 DateTime?
  lastInventoryReconcileAt        DateTime?
  lastCollectionReconcileAt       DateTime?
  mirrorUnsafeSince               DateTime?
  lastSyncErrorSummary            String?
  scope                           String?           @default("")
  installedAt                     DateTime?
  unInstalledAt                   DateTime?
  isUnInstalled                   Boolean           @default(false)
  installationGeneration          String?
  installationStatus              String            @default("pending")
  installationProcessingStartedAt DateTime?
  installationSetupCompletedAt    DateTime?
  referralCode                    String?           @unique
  referralLink                    String?           @unique
  referredBy                      String?
  refIsFirstSubscriptionCompleted Boolean           @default(false)
  refSubscribedDate               DateTime?
  refRewardExpiresAt              DateTime?
  refRewarded                     Boolean           @default(false)
  refSubscribedPlanDetails        Json?
  refEarnedPrice                  Decimal           @default(0) @db.Decimal(20, 6)
  isCreditAvailable               Boolean           @default(false)
  lastActivityAt                  DateTime?
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
  mirrorBatches                   MirrorBatch[]

  @@index([isProductSyncing])
  @@index([lastProductSyncAt])
  @@index([lastProductSyncAttemptAt])
  @@index([lastProductSyncSubmittedAt])
  @@index([productSyncStartedAt])
  @@index([productSyncRecoveryRequired])
  @@index([isCollectionSyncing])
  @@index([lastCollectionSyncAt])
  @@index([lastProductTypeSyncAt])
  @@index([referralCode])
  @@index([referredBy])
  @@index([lastActivityAt])
  @@index([isUnInstalled])
  @@index([installedAt])
  @@index([installationGeneration])
  @@index([installationStatus])
  @@index([installationProcessingStartedAt])
  @@index([createdAt])
}

model Subscription {
  id                    String             @id @default(cuid())
  shop                  String             @unique
  planKey               String?
  planName              String?
  subscriptionId        String?
  status                SubscriptionStatus @default(FREE)
  pendingSubscriptionId String?
  pendingPlanKey        String?
  pendingPlanName       String?
  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([shop])
}

model Suggestion {
  id         String   @id @default(cuid())
  email      String
  suggestion String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
}

model SyncHistory {
  id                   String             @id @default(cuid())
  shop                 String
  bulkOperationId      String?
  syncBatchId          String?
  responseUrl          String?
  status               SyncStatus         @default(processing)
  stage                String?
  errorMessage         String?
  duration             Int?               @default(0)
  recordCount          Int?
  operationType        SyncOperationType?
  isInitialProductSync Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  executionState       String             @default("planned")
  executionIdentity    String?
  lastHeartbeatAt      DateTime?
  completedAt          DateTime?
  mirrorBatch          MirrorBatch?

  @@index([shop, createdAt])
  @@index([shop, status])
  @@index([shop, operationType])
  @@index([shop, executionState])
  @@unique([shop, bulkOperationId, operationType])
}

model MirrorBatch {
  id                    String            @id
  shop                  String
  resourceType          MirrorResourceType @default(PRODUCT_CATALOG)
  status                MirrorBatchStatus @default(SYNC_REQUESTED)
  syncHistoryId         String?           @unique
  bulkOperationId       String?
  expectedProducts      Int?
  actualProducts        Int?
  expectedVariants      Int?
  actualVariants        Int?
  expectedCollections   Int?
  actualCollections     Int?
  expectedMetafields    Int?
  actualMetafields      Int?
  activatedAt           DateTime?
  failedAt              DateTime?
  failureReason         String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  store                 Store             @relation(fields: [shop], references: [shopUrl], onDelete: Cascade)
  syncHistory           SyncHistory?      @relation(fields: [syncHistoryId], references: [id], onDelete: SetNull)

  @@unique([shop, id])
  @@index([shop, resourceType, status])
  @@index([shop, status, createdAt])
  @@index([shop, bulkOperationId])
}

model EditHistory {
  id                        String                 @id @default(cuid())
  shop                      String
  bulkOperationId           String?
  executionState            String                 @default("planned")
  executionStateNormalized  EditHistoryExecutionState @default(PLANNED)
  executionIdentity         String?                @unique
  targetSnapshotCount       Int                    @default(0)
  targetMirrorBatchId       String?
  failureStage              String?
  title                     Json?
  queryFilter               String                 @default("")
  editedType                String?
  rules                     Json?
  affectedFields            Json?
  locationId                String?
  status                    String                 @default("pending")
  statusNormalized          EditHistoryStatus      @default(PENDING)
  scheduledAt               DateTime?
  scheduledUndoAt           DateTime?
  processedCount            Int                    @default(0)
  totalItems                Int                    @default(0)
  totalRows                 Int                    @default(0)
  durationMs                Int                    @default(0)
  editTime                  DateTime               @default(now())
  startedAt                 DateTime
  completedAt               DateTime?
  undo                      Json?
  batch                     Json?
  type                      String?                @default("Manual edit")
  processingBatchId         String?
  scheduledTask             String?
  user                      String?
  isFavourite               Boolean                @default(false)
  isSpreadsheetEdit         Boolean                @default(false)
  isRecurring               Boolean                @default(false)
  recurringEditId           String?
  recurringRunId            String?
  snapshotSetId             String?
  automaticProductRuleId    String?
  automaticProductRuleRunId String?                @unique
  sourceEditHistoryId       String?
  triggerType               EditHistoryTriggerType @default(MANUAL)
  error                     Json?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  filterVersion             Int?
  canonicalFilterKey        String?
  filterAst                 Json?
  normalizedFilterAst       Json?
  targetingSnapshotMeta     Json?
  targetingMode             String?
  targetGranularity         String?
  targetingCompilerVersion  String?
  fieldRegistryVersion      String?
  operatorRegistryVersion   String?
  filterHash                String?
  targetResolvedAt          DateTime?
  entitlementSnapshot       Json?
  actorType                 String?
  actorId                   String?
  actorEmail                String?
  actorName                 String?
  cancelRequestedAt         DateTime?
  cancelledAt               DateTime?
  cancelReason              String?
  pauseRequestedAt          DateTime?
  pausedAt                  DateTime?
  resumedAt                 DateTime?
  changeRecords             ChangeRecord[]
  ingestionCheckpoints      EditHistoryIngestionCheckpoint[]
  undoOperations            UndoOperation[]        @relation("UndoSourceHistory")
  undoJobOperation          UndoOperation?          @relation("UndoJobHistory")
  sourceEditHistory         EditHistory?            @relation("EditHistoryUndoChain", fields: [sourceEditHistoryId], references: [id], onDelete: SetNull)
  derivedUndoJobs           EditHistory[]           @relation("EditHistoryUndoChain")
  recoveryAudits            BulkEditRecoveryAudit[]
  snapshotSet               TargetSnapshotSet?     @relation(fields: [snapshotSetId], references: [id])

  @@index([shop, status, type, updatedAt], map: "shop_status_type_recent")
  @@index([shop])
  @@index([shop, executionState])
  @@index([shop, executionStateNormalized])
  @@index([shop, executionIdentity])
  @@index([shop, statusNormalized, type, updatedAt], map: "shop_status_norm_type_recent")
  @@index([isSpreadsheetEdit])
  @@index([recurringEditId])
  @@index([recurringRunId])
  @@index([shop, snapshotSetId])
  @@index([automaticProductRuleId])
  @@index([automaticProductRuleRunId])
  @@index([shop, canonicalFilterKey])
  @@index([shop, sourceEditHistoryId])
}

model UndoOperation {
  id                 String   @id @default(cuid())
  shop               String
  sourceEditHistoryId String
  executionIdentity  String   @unique
  idempotencyKeyHash String?
  status             String   @default("pending")
  state              String   @default("queued")
  bulkOperationId    String?
  undoEditHistoryId  String?  @unique
  processedCount     Int      @default(0)
  totalEligibleCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  editHistory        EditHistory  @relation("UndoSourceHistory", fields: [sourceEditHistoryId], references: [id], onDelete: Cascade)
  undoEditHistory    EditHistory? @relation("UndoJobHistory", fields: [undoEditHistoryId], references: [id], onDelete: SetNull)
  conflictChunks     UndoOperationConflictChunk[]

  @@unique([shop, sourceEditHistoryId])
  @@index([shop, status, updatedAt])
  @@index([shop, undoEditHistoryId])
}

model UndoOperationConflictChunk {
  id              String   @id @default(cuid())
  shop            String
  undoOperationId String
  chunkType       String
  chunkIndex      Int
  totalItems      Int      @default(0)
  payload         Json
  createdAt       DateTime @default(now())

  undoOperation   UndoOperation @relation(fields: [undoOperationId], references: [id], onDelete: Cascade)

  @@unique([shop, undoOperationId, chunkType, chunkIndex])
  @@index([shop, undoOperationId, chunkType, chunkIndex])
}

model BulkEditRecoveryAudit {
  id             String   @id @default(cuid())
  shop           String
  historyId      String
  mode           String
  reason         String
  actorType      String?
  actorId        String?
  actorEmail     String?
  result         String
  metadata       Json?
  createdAt      DateTime @default(now())

  editHistory    EditHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  @@index([shop, historyId, createdAt])
}

model EditHistoryIngestionCheckpoint {
  id               String   @id @default(cuid())
  shop             String
  historyId        String
  ingestionRunId   String
  attempt          Int      @default(1)
  status           String   @default("IN_PROGRESS")
  rowOffset        Int      @default(0)
  rowCount         Int      @default(0)
  successCount     Int      @default(0)
  failureCount     Int      @default(0)
  unmappedRowCount Int      @default(0)
  malformedRowCount Int     @default(0)
  rollingChecksum  String?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  editHistory      EditHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  @@unique([shop, historyId, ingestionRunId])
  @@index([shop, historyId, status, updatedAt])
  @@index([shop, historyId, updatedAt])
}

model RecurringEdit {
  id                 String                @id @default(cuid())
  shop               String
  title              String
  status             RecurringEditStatus   @default(ACTIVE)
  scheduleType       RecurringScheduleType
  timezone           String
  scheduleConfig     Json
  cronExpression     String?
  intervalMinutes    Int?
  startAt            DateTime?
  endAt              DateTime?
  filterParams       Json
  rules              Json
  runCount           Int                   @default(0)
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  lastSuccessAt      DateTime?
  lastFailureAt      DateTime?
  lastFailureReason  String?
  isDeleted          Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  filterVersion      Int                   @default(1)
  canonicalFilterKey String?
  filterAst          Json?
  normalizedFilterAst Json?
  targetingSnapshotMeta Json?
  targetingMode      String?
  targetGranularity  String?
  targetingCompilerVersion String?
  fieldRegistryVersion String?
  operatorRegistryVersion String?
  filterHash         String?
  actorType          String?
  actorId            String?
  actorEmail         String?
  actorName          String?
  runs               RecurringEditRun[]

  @@index([shop])
  @@index([shop, status])
  @@index([shop, nextRunAt])
