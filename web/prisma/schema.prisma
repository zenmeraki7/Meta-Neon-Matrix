generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  shop             String
  id               String
  mirrorBatchId    String
  title            String
  handle           String?
  status           String
  /// Application-normalized projection. Raw Shopify status remains in `status`.
  statusNormalized String @default("UNKNOWN") @db.VarChar(32)
  productType      String?
  vendor           String?
  tags             String[]
  templateSuffix   String?

  // split raw html from filterable text
  descriptionHtml String?
  descriptionText String?

  createdAt                   DateTime?
  updatedAt                   DateTime?
  publishedAt                 DateTime?
  seoTitle                    String?
  seoDescription              String?
  totalInventory              Int?
  categoryId                  String?
  categoryName                String?
  googleShoppingEnabled       Boolean?
  googleShoppingAgeGroup      String?
  googleShoppingCategory      String?
  googleShoppingColor         String?
  googleShoppingCondition     String?
  googleShoppingCustomLabel0  String?
  googleShoppingCustomLabel1  String?
  googleShoppingCustomLabel2  String?
  googleShoppingCustomLabel3  String?
  googleShoppingCustomLabel4  String?
  googleShoppingCustomProduct Boolean?
  googleShoppingGender        String?
  googleShoppingMpn           String?
  googleShoppingMaterial      String?
  googleShoppingSize          String?
  googleShoppingSizeSystem    String?
  googleShoppingSizeType      String?
  categoryAgeGroup            String?
  categoryColor               String?
  categoryFabric              String?
  categoryFit                 String?
  categorySize                String?
  categoryTargetGender        String?
  categoryWaistRise           String?
  featuredImageUrl            String?
  featuredImageAltText        String?
  optionsJson                 Json?
  collectionsJson             Json?
  option1Name                 String?
  option2Name                 String?
  option3Name                 String?
  variantCount                Int?      @default(0)
  visibleOnlineStore          Boolean?
  lastSourceEntityUpdatedAt   DateTime? @map("lastSourceUpdatedAt")
  lastSourceEventOccurredAt   DateTime? @map("lastSourceEventAt")
  sourceVersion               String?
  lastChangeSource            String?   @map("lastSourceKind")
  reconciliationCompletedAt   DateTime? @map("lastReconciledAt")
  isDeleted                   Boolean   @default(false)
  variants                    Variant[]
  mirrorBatch                 MirrorBatch @relation(fields: [shop, mirrorBatchId], references: [shop, id], onDelete: Cascade)
  media                       ProductMediaMirror[]
  inventoryItems              InventoryItemMirror[]
  collections                 ProductCollection[]

  @@id([shop, id, mirrorBatchId])
  @@index([shop, mirrorBatchId])
  @@index([shop, mirrorBatchId, categoryAgeGroup])
  @@index([shop, mirrorBatchId, categoryColor])
  @@index([shop, mirrorBatchId, categoryName])
  @@index([shop, mirrorBatchId, categorySize])
  @@index([shop, mirrorBatchId, categoryTargetGender])
  @@index([shop, mirrorBatchId, googleShoppingCategory])
  @@index([shop, mirrorBatchId, googleShoppingCondition])
  @@index([shop, mirrorBatchId, googleShoppingGender])
  @@index([shop, mirrorBatchId, googleShoppingAgeGroup])
  @@index([shop, mirrorBatchId, googleShoppingColor])
  @@index([shop, mirrorBatchId, googleShoppingMaterial])
  @@index([shop, mirrorBatchId, googleShoppingMpn])
  @@index([shop, mirrorBatchId, googleShoppingSize])
  @@index([shop, mirrorBatchId, option1Name])
  @@index([shop, mirrorBatchId, option2Name])
  @@index([shop, mirrorBatchId, option3Name])
  @@index([shop, mirrorBatchId, productType])
  @@index([shop, mirrorBatchId, vendor])
  @@index([shop, mirrorBatchId, statusNormalized])
  @@index([shop, mirrorBatchId, title, id])
  @@index([shop, mirrorBatchId, handle, id])
  @@index([shop, mirrorBatchId, createdAt, id])
  @@index([shop, mirrorBatchId, updatedAt, id])
  @@index([shop, mirrorBatchId, publishedAt, id])
  @@index([shop, mirrorBatchId, variantCount])
  @@index([shop, mirrorBatchId, templateSuffix])
}

model Variant {
  shop                String
  id                  String
  productId           String
  mirrorBatchId       String
  inventoryItemId     String?
  title               String?
  sku                 String?
  barcode             String?
  price               Decimal? @db.Decimal(20, 4)
  compareAtPrice      Decimal? @db.Decimal(20, 4)
  inventoryQuantity   Int?
  inventoryPolicy     String?
  taxable             Boolean?
  taxCode             String?
  position            Int?
  selectedOptionsJson Json?
  cost                Decimal? @db.Decimal(20, 4)
  countryOfOrigin     String?
  hsTariffCode        String?
  weight              Decimal? @db.Decimal(20, 6)
  weightUnit          String?
  option1Value        String?
  option2Value        String?
  option3Value        String?
  physicalProduct     Boolean?
  /// Ratio, not percentage: (price - cost) / price. Rounded to 8 decimals.
  profitMarginRatio   Decimal? @db.Decimal(12, 8)
  tracked             Boolean?
  sourceEntityUpdatedAt DateTime?
  sourceEventOccurredAt DateTime?
  sourceVersion         String?
  lastChangeSource      String?
  reconciliationCompletedAt DateTime?
  isDeleted             Boolean @default(false)
  product             Product  @relation(fields: [shop, productId, mirrorBatchId], references: [shop, id, mirrorBatchId], onDelete: Cascade)
  inventoryItems      InventoryItemMirror[]

  @@id([shop, id, mirrorBatchId])
  @@index([shop, mirrorBatchId])
  // Required by cross-batch product-delete webhook cleanup.
  @@index([shop, productId])
  @@index([shop, mirrorBatchId, title])
  @@index([shop, mirrorBatchId, cost])
  @@index([shop, mirrorBatchId, countryOfOrigin])
  @@index([shop, mirrorBatchId, hsTariffCode])
  @@index([shop, mirrorBatchId, inventoryPolicy])
  @@index([shop, mirrorBatchId, weight])
  @@index([shop, mirrorBatchId, option1Value])
  @@index([shop, mirrorBatchId, option2Value])
  @@index([shop, mirrorBatchId, option3Value])
  @@index([shop, mirrorBatchId, weightUnit])
  @@index([shop, mirrorBatchId, sku])
  @@index([shop, mirrorBatchId, barcode])
  @@index([shop, mirrorBatchId, inventoryItemId])
  @@index([shop, mirrorBatchId, price])
  @@index([shop, mirrorBatchId, compareAtPrice])
  @@index([shop, mirrorBatchId, inventoryQuantity])
  @@index([shop, mirrorBatchId, position])
  @@index([shop, mirrorBatchId, productId, position])
}

/// Legacy variant-metafield working projection. Store.shopUrl is the tenant key.
/// Retain until the metafield-bulk-write queue is drained and its loaded worker,
/// raw-SQL repositories, session ledger, and dead-letter path are retired together.
model VariantMetafield {
  id                 BigInt     @id @default(autoincrement())
  shopDomain             String     @map("shop_id")
  /// Compatibility projection for the drained v1 queue only.
  variantId          BigInt?    @map("variant_id")
  variantGid         String     @map("variant_gid") @db.VarChar(255)
  shopifyMetafieldId String?    @map("shopify_metafield_id")
  namespace          String
  key                String
  metafieldType      String? @map("type")
  value              String?
  pendingValue       String?    @map("pending_value")
  compareDigest      String?    @map("compare_digest")
  shopifyVersion     BigInt     @default(0) @map("shopify_version")
  editStatus         EditStatus @default(SYNCED) @map("edit_status")
  isDirty            Boolean    @default(false) @map("is_dirty")
  lastEditedAt       DateTime?  @map("last_edited_at")
  shopifySynchronizedAt DateTime? @map("last_synced_at")

  shop    Store            @relation(fields: [shopDomain], references: [shopUrl], onDelete: Cascade)
  changes BulkEditChange[]

  @@unique([shopDomain, variantGid, namespace, key])
  @@index([shopDomain, variantId, namespace, key], map: "variant_metafields_legacy_identity_idx")
  @@unique([shopDomain, id])
  @@index([shopDomain, isDirty])
  @@map("variant_metafields")
}

model DeadLetterChange {
  id             String   @id @db.Uuid
  originalChange Json     @map("original_change")
  errorCode      String   @map("error_code")
  failedAt       DateTime @default(now()) @map("failed_at")
  shopDomain         String   @map("shop_id")
  notified       Boolean  @default(false)

  @@index([shopDomain, failedAt])
  @@index([notified, failedAt])
  @@map("dead_letter_changes")
}

model BulkEditSession {
  id        BigInt        @id @default(autoincrement())
  shopDomain    String        @map("shop_id")
  status    SessionStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  shop    Store            @relation(fields: [shopDomain], references: [shopUrl], onDelete: Cascade)
  changes BulkEditChange[]

  @@index([shopDomain, status, updatedAt])
  @@index([shopDomain, createdAt, id])
  @@unique([shopDomain, id])
  @@map("bulk_edit_sessions")
}

model BulkEditChange {
  id                 BigInt       @id @default(autoincrement())
  shopDomain             String       @map("shop_id")
  sessionId          BigInt       @map("session_id")
  variantMetafieldId BigInt       @map("variant_metafield_id")
  newValue           String       @map("new_value")
  compareDigest      String       @map("compare_digest")
  status             ChangeStatus @default(PENDING)
  errorCode          String?      @map("error_code")
  retryable          Boolean      @default(true)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  session          BulkEditSession  @relation(fields: [shopDomain, sessionId], references: [shopDomain, id])
  variantMetafield VariantMetafield @relation(fields: [shopDomain, variantMetafieldId], references: [shopDomain, id])

  @@unique([shopDomain, sessionId, variantMetafieldId])
  @@index([shopDomain, sessionId, status])
  @@index([shopDomain, status, updatedAt])
  @@map("bulk_edit_changes")
}

model SyncCursor {
  id           BigInt    @id @default(autoincrement())
  shopDomain       String    @map("shop_id")
  syncResourceType String @map("resource_type")
  cursorValue  String?   @map("cursor_value")
  cursorAdvancedAt DateTime? @map("last_synced_at")

  shop Store @relation(fields: [shopDomain], references: [shopUrl], onDelete: Cascade)

  @@unique([shopDomain, syncResourceType])
  @@map("sync_cursors")
}

model SpreadsheetFile {
  id                 String    @id @default(cuid())
  shop               String
  storageKey         String    @default("")
  contentSha256      String    @default("") @map("checksum")
  sizeBytes          BigInt    @default(0)
  editHistoryId      String?
  operationType      String?
  operationId        String?
  status             String    @default("UPLOADED")
  originalFilename   String?
  rowParseErrorCount Int?      @default(0)
  previewedAt        DateTime?
  executionClaimedAt DateTime?
  validatedAt        DateTime?
  downloadUrl        String?   @map("fileUrl")
  columnMappings     Json?
  totalRows          Int?
  expiresAt          DateTime?
  storageDeletedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([shop, id])
  @@unique([shop, contentSha256, id])
  @@index([shop, createdAt, id])
  @@index([shop, editHistoryId])
  @@index([shop, operationType, operationId])
  @@index([expiresAt, id])
}

model Store {
  id                              String            @id @default(cuid())
  shopUrl                         String            @unique
  shopEmail                       String?
  /// Authoritative application credential store.
  accessTokenEncrypted            String?
  accessTokenKeyVersion           String?
  currentProductMirrorBatchId     String? @map("activeMirrorBatchId")
  mirrorMutationVersion           BigInt            @default(0)
  currentCollectionMirrorBatchId  String? @map("activeCollectionBatchId")
  isCollectionSyncing             Boolean           @default(false)
  lastCollectionSyncAt            DateTime?
  isProductTypeSyncing            Boolean           @default(false)
  lastProductTypeSyncAt           DateTime?
  isProductInitiallySyncing       Boolean           @default(false) @map("isProductInitialySyning")
  productInitialSyncProgress      Int               @default(0)
  /// Authoritative product-sync lifecycle state. Boolean fields are compatibility projections.
  syncProgressStage               SyncProgressStage @default(IDLE)
  hasCompletedShopifyBulkJob      Boolean           @default(false) @map("shopifyBulkJobCompleted")
  storeTotalProducts              Int               @default(0)
  isProductSyncing                Boolean           @default(false)
  lastProductSyncAt               DateTime?
  lastProductSyncAttemptAt        DateTime?
  lastProductSyncSubmittedAt      DateTime?
  productSyncStartedAt            DateTime?
  requiresProductSyncRecovery     Boolean           @default(false) @map("productSyncRecoveryRequired")
  mirrorHealthState               MirrorHealthState @default(HEALTHY)
  staleReason                     String?
  requiresMirrorRepair            Boolean           @default(false) @map("repairRequired")
  lastFullSyncAt                  DateTime?
  lastIncrementalSyncAt           DateTime?
  lastWebhookProcessedAt          DateTime?
  lastReconcileAt                 DateTime?
  lastInventoryReconcileAt        DateTime?
  lastCollectionReconcileAt       DateTime?
  mirrorUnsafeSince               DateTime?
  lastSyncErrorSummary            String?
  oauthScopes                     String?           @default("") @map("scope")
  installedAt                     DateTime?
  uninstalledAt                   DateTime?          @map("unInstalledAt")
  installationStatus              StoreInstallationStatus @default(INSTALLED)
  installationExecutionId         String?
  installationStage               String?
  installationLeaseUntil          DateTime?
  installationAttemptCount        Int                     @default(0)
  referralCode                    String?           @unique
  referralLink                    String?           @unique
  referredBy                      String?
  refIsFirstSubscriptionCompleted Boolean           @default(false)
  refSubscribedDate               DateTime?
  refRewardExpiresAt              DateTime?
  refRewarded                     Boolean           @default(false)
  refSubscribedPlanDetails        Json?
  refEarnedPrice                  Decimal           @default(0) @db.Decimal(20, 4)
  isCreditAvailable               Boolean           @default(false)
  lastActivityAt                  DateTime?
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
  mirrorBatches                   MirrorBatch[]
  currentProductMirrorBatch       MirrorBatch?       @relation("ActiveMirrorBatch", fields: [shopUrl, currentProductMirrorBatchId], references: [shop, id], onDelete: Restrict)
  currentCollectionMirrorBatch    MirrorBatch?       @relation("ActiveCollectionBatch", fields: [shopUrl, currentCollectionMirrorBatchId], references: [shop, id], onDelete: Restrict)
  productTombstones               ProductTombstone[]
  mirrorMutationJournals          MirrorMutationJournal[]
  variantMetafields               VariantMetafield[]
  bulkEditSessions                BulkEditSession[]
  syncCursors                     SyncCursor[]

  @@index([isProductSyncing])
  @@index([syncProgressStage, updatedAt])
  @@index([lastProductSyncAt])
  @@index([lastProductSyncAttemptAt])
  @@index([lastProductSyncSubmittedAt])
  @@index([productSyncStartedAt])
  @@index([requiresProductSyncRecovery])
  @@index([isCollectionSyncing])
  @@index([lastCollectionSyncAt])
  @@index([lastProductTypeSyncAt])
  @@index([referredBy])
  @@index([lastActivityAt])
  @@index([installationStatus])
  @@index([installedAt])
  @@index([createdAt])
}

model Subscription {
  id                      String             @id @default(cuid())
  shop                    String             @unique
  planKey                 String?
  planName                String?
  subscriptionId          String?
  status                  SubscriptionStatus @default(FREE)
  pendingSubscriptionId   String?
  pendingPlanKey          String?
  pendingPlanName         String?
  trialEndsAt             DateTime?
  currentPeriodEnd        DateTime?
  billingAuthorityVersion BigInt             @default(0)
  billingReconciledAt     DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

}

/// One authoritative entitlement accounting window. Aggregate amounts are
/// projections of the immutable ledger and can be rebuilt during recovery.
model UsagePeriod {
  id                      String   @id @default(cuid())
  shop                    String
  entitlementKey          String
  periodStartsAt          DateTime
  periodEndsAt            DateTime
  reservedAmount          BigInt   @default(0)
  consumedAmount          BigInt   @default(0)
  releasedAmount          BigInt   @default(0)
  billingAuthorityVersion BigInt
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  reservations            UsageReservation[]
  ledgerEntries           UsageLedgerEntry[]

  @@unique([shop, id])
  @@unique([shop, entitlementKey, periodStartsAt, periodEndsAt])
  @@index([shop, entitlementKey, periodEndsAt])
}

model UsageReservation {
  id                      String   @id @default(cuid())
  shop                    String
  periodId                String
  entitlementKey          String
  operationType           String
  operationId             String
  reservedAmount          BigInt
  consumedAmount          BigInt   @default(0)
  releasedAmount          BigInt   @default(0)
  status                  String   @default("RESERVED")
  idempotencyKeyHash      String
  subscriptionVersion     BigInt
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  consumedAt              DateTime?
  releasedAt              DateTime?
  period                  UsagePeriod @relation(fields: [shop, periodId], references: [shop, id], onDelete: Restrict)
  ledgerEntries           UsageLedgerEntry[]

  @@unique([shop, id])
  @@unique([shop, operationType, operationId, entitlementKey])
  @@unique([shop, idempotencyKeyHash])
  @@index([shop, periodId, entitlementKey, status])
}

model UsageLedgerEntry {
  id                      String   @id @default(cuid())
  shop                    String
  usagePeriodId           String
  reservationId           String
  entitlementKey          String
  operationType           String
  operationId             String
  entryType               String
  amount                  BigInt
  idempotencyKey          String
  billingAuthorityVersion BigInt
  createdAt               DateTime @default(now())
  period                  UsagePeriod @relation(fields: [shop, usagePeriodId], references: [shop, id], onDelete: Restrict)
  reservation             UsageReservation @relation(fields: [shop, reservationId], references: [shop, id], onDelete: Restrict)

  @@unique([shop, id])
  @@unique([shop, idempotencyKey])
  @@index([shop, usagePeriodId, createdAt])
  @@index([shop, reservationId, createdAt])
  @@index([shop, operationType, operationId, entitlementKey])
}

model Suggestion {
  id         String   @id @default(cuid())
  email      String
  emailNormalized String
  suggestion String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([emailNormalized])
}

model SyncHistory {
  id                   String             @id @default(cuid())
  shop                 String
  shopifyBulkOperationId      String?            @map("bulkOperationId")
  mirrorBatchId          String?            @map("syncBatchId")
  sourceResponseUrl    String?   @map("responseUrl")
  status               SyncStatus         @default(processing)
  stage                String?
  errorMessage         String?
  duration             Int?               @default(0)
  recordCount          Int?
  operationType        SyncOperationType?
  isInitialProductSync Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  executionState       String             @default("planned")
  executionIdentity    String?
  lastHeartbeatAt      DateTime?
  completedAt          DateTime?
  mirrorBatch          MirrorBatch?

  @@unique([shop, id])
  @@index([shop, createdAt, id])
  @@index([shop, status, updatedAt, id])
  @@index([shop, operationType])
  @@index([shop, executionState])
  @@index([shop, operationType, status, completedAt])
  @@index([shop, operationType, createdAt])
}

model MirrorBatch {
  id                    String
  shop                  String
  mirrorResourceType    MirrorResourceType @default(PRODUCT_CATALOG) @map("resourceType")
  status                MirrorBatchStatus  @default(SYNC_REQUESTED)
  syncHistoryId         String?
  shopifyBulkOperationId       String?             @map("bulkOperationId")
  expectedProducts      Int?
  actualProducts        Int?
  expectedVariants      Int?
  actualVariants        Int?
  expectedCollections   Int?
  actualCollections     Int?
  expectedMetafields    Int?
  actualMetafields      Int?
  activatedAt           DateTime?
  failedAt              DateTime?
  failureReason         String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  store                 Store              @relation(fields: [shop], references: [shopUrl], onDelete: Cascade)
  syncHistory           SyncHistory?       @relation(fields: [shop, syncHistoryId], references: [shop, id], onDelete: Restrict)
  expectedPreviousActiveBatchId      String? @map("expectedActiveBatchId")
  replayStartSequence                BigInt? @map("syncStartSequence")
  replayFinalizedThroughSequence     BigInt? @map("finalizedSequence")
  finalizedAt           DateTime?
  retiredAt             DateTime?
  cleanupStartedAt      DateTime?
  cleanedAt             DateTime?
  products              Product[]
  collections           Collection[]
  metafields            MetafieldMirror[]
  targetSnapshotSets    TargetSnapshotSet[]
  activeForStores       Store[]             @relation("ActiveMirrorBatch")
  activeForCollectionStores Store[]          @relation("ActiveCollectionBatch")

  @@id([shop, id])
  @@unique([shop, syncHistoryId])
  @@index([shop, mirrorResourceType, status])
  @@index([shop, status, createdAt])
  @@index([shop, shopifyBulkOperationId], map: "MirrorBatch_shop_bulkOperationId_idx")
  @@index([shop, replayStartSequence])
  @@index([shop, replayFinalizedThroughSequence])
  @@index([shop, status, retiredAt])
}

model EditHistory {
  id                        String                           @id @default(cuid())
  shop                      String
  stateVersion              Int                              @default(0)
  executionOwnerId          String?
  executionLeaseUntil       DateTime?
  executionHeartbeatAt      DateTime?
  executeLeaseFencingToken  BigInt?
  executeLeaseOwner         String?
  executeLeaseExpiresAt     DateTime?
  lastHeartbeatAt           DateTime?
  shopifyBulkOperationId    String?                          @map("bulkOperationId")
  /// Legacy lifecycle detail; workflow selection must use executionStateNormalized.
  executionState            String                           @default("planned")
  executionStateNormalized  EditHistoryExecutionState        @default(PLANNED)
  executionIdentity         String?
  targetSnapshotCount       Int                              @default(0)
  targetProductMirrorBatchId String?                          @map("targetMirrorBatchId")
  failureStage              String?
  failureCode               String?
  latestErrorMessage        String?
  latestErrorAt             DateTime?
  retryCount                Int                              @default(0)
  title                     Json?
  legacyQueryFilter         String                           @default("") @map("queryFilter")
  editedType                String?
  rules                     Json?
  affectedFieldKeys         Json?                            @map("affectedFields")
  locationId                String?
  /// Legacy source/UI projection; workflow selection must use statusNormalized.
  status                    String                           @default("pending")
  statusNormalized          EditHistoryStatus                @default(PENDING)
  scheduledAt               DateTime?
  scheduledUndoAt           DateTime?
  processedCount            Int                              @default(0)
  totalItems                Int                              @default(0)
  totalRows                 Int                              @default(0)
  durationMs                Int                              @default(0)
  requestedAt               DateTime                         @default(now()) @map("editTime")
  startedAt                 DateTime
  completedAt               DateTime?
  undo                      Json?
  batch                     Json?
  editType                  String?                          @default("Manual edit") @map("type")
  processingChunkId         String?                          @map("processingBatchId")
  scheduledTask             String?
  legacyUser                String?                          @map("user")
  isFavourite               Boolean                          @default(false)
  isSpreadsheetEdit         Boolean                          @default(false)
  isRecurring               Boolean                          @default(false)
  recurringEditId           String?
  recurringRunId            String?
  snapshotSetId             String?
  snapshotSetRevision       Int?                             @default(1)
  automaticProductRuleId    String?
  automaticProductRuleRunId String?
  triggerType               EditHistoryTriggerType           @default(MANUAL)
  error                     Json?
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  retentionUntil            DateTime? @default(dbgenerated("(now() + interval '7 years')"))
  redactedAt                DateTime?
  filterVersion             Int?
  canonicalFilterKey        String?
  filterAst                 Json?
  normalizedFilterAst       Json?
  targetingSnapshotMeta     Json?
  targetFreezeMode          String?                          @map("targetingMode")
  targetGranularity         String?
  targetingCompilerVersion  String?
  fieldRegistryVersion      String?
  operatorRegistryVersion   String?
  normalizedFilterHash      String?                          @map("filterHash")
  targetResolvedAt          DateTime?
  entitlementSnapshot       Json?
  actorType                 String?
  actorId                   String?
  actorEmail                String?
  actorDisplayName          String?                          @map("actorName")
  cancelRequestedAt         DateTime?
  cancelledAt               DateTime?
  cancelReason              String?
  pauseRequestedAt          DateTime?
  pausedAt                  DateTime?
  resumedAt                 DateTime?
  operationType             String?                          @default("BULK_EDIT")
  idempotencyKey            String?
  changeRecords             ChangeRecord[]
  ingestionCheckpoints      EditHistoryIngestionCheckpoint[]
  undoOperations            UndoOperation[]
  recoveryAudits            BulkEditRecoveryAudit[]
  immutableEditCommands     ImmutableEditCommand[]
  failureAttempts           EditHistoryFailureAttempt[]
  snapshotSet               TargetSnapshotSet?               @relation(fields: [shop, snapshotSetId], references: [shop, id], onDelete: Restrict)

  @@index([shop, executionStateNormalized])
  @@index([shop, executionStateNormalized, stateVersion, id])
  @@index([shop, executionStateNormalized, executeLeaseExpiresAt, id])
  @@unique([shop, id])
  @@unique([shop, executionIdentity])
  @@unique([shop, operationType, idempotencyKey])
  @@index([shop, executionState, createdAt, id])
  @@index([shop, executionState, id])
  @@index([shop, statusNormalized])
  @@index([shop, statusNormalized, editType, updatedAt], map: "shop_status_norm_type_recent")
  @@index([shop, createdAt, id])
  @@index([shop, statusNormalized, updatedAt, id])
  @@index([isSpreadsheetEdit])
  @@index([shop, recurringEditId])
  @@index([shop, recurringRunId])
  @@index([shop, snapshotSetId])
  @@index([shop, automaticProductRuleId])
  @@index([shop, automaticProductRuleRunId])
  @@index([shop, canonicalFilterKey])
}


model ImmutableEditCommand {
  id                String   @id @default(cuid())
  shop              String
  historyId         String
  executionIdentity String?
  revision          Int      @default(1)
  command           Json
  commandHash       String
  payload           Json?
  payloadHash       String?
  createdAt         DateTime @default(now())

  history EditHistory @relation(fields: [shop, historyId], references: [shop, id], onDelete: Restrict)


  @@unique([shop, historyId])
  @@unique([shop, historyId, revision])
  @@index([shop, commandHash])
}


model UndoOperation {
  id                  String    @id @default(cuid())
  shop                String
  sourceEditHistoryId String
  previewContractId   String?
  executionId         String?
  executionIdentity   String
  idempotencyKeyHash  String
  /// Nullable during migration. New undo operations must own an immutable item set.
  undoItemSetRevision Int       @default(1)
  serializerVersion   String?
  trustStatus         UndoOperationTrustStatus @default(TRUSTED)
  approvedAt          DateTime?
  approvedByActorId   String?
  /// Durable domain result (pending/completed/partial/failed).
  outcomeStatus       String    @default("pending") @map("status")
  /// Runtime state used by claims, retries, and Shopify dispatch.
  executionState      String    @default("queued") @map("state")
  shopifyBulkOperationId     String?   @map("bulkOperationId")
  processedCount      Int       @default(0)
  totalEligibleCount  Int       @default(0)
  restoredCount       Int       @default(0)
  failedCount         Int       @default(0)
  skippedCount        Int       @default(0)
  conflictedCount     Int       @default(0)
  failureCode         String?   @map("errorCode")
  failureMessage      String?   @map("errorMessage")
  requestedAt         DateTime  @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  retentionUntil      DateTime? @default(dbgenerated("(now() + interval '7 years')"))
  redactedAt           DateTime?

  editHistory    EditHistory                  @relation(fields: [shop, sourceEditHistoryId], references: [shop, id], onDelete: Restrict)
  previewContract PreviewContract?             @relation(fields: [shop, previewContractId], references: [shop, id], onDelete: Restrict)
  command        UndoCommand?
  conflictChunks UndoOperationConflictChunk[]
  items          UndoItem[]

  @@unique([shop, id])
  @@unique([shop, executionIdentity])
  @@unique([shop, idempotencyKeyHash])
  @@index([shop, outcomeStatus, updatedAt], map: "UndoOperation_shop_status_updatedAt_idx")
  @@index([shop, sourceEditHistoryId, createdAt])
  @@index([shop, previewContractId])
}

/// Immutable authority for one field in an undo revision. Runtime workers may
/// update outcome metadata only; targets, restore values, and hashes never change.
model UndoItem {
  id                       String                @id @default(cuid())
  shop                     String
  undoOperationId          String
  targetIdentity           String
  targetResourceType       TargetSnapshotTargetType
  targetId                 String
  productId                String
  variantId                String?
  fieldPath                String
  targetContext            Json
  beforeValue              Json
  beforeValueHash          String
  writtenValueHash         String
  observedCurrentValueHash String?
  serializerVersion        String
  outcome                  UndoItemOutcome       @default(ELIGIBLE)
  failureCode              String?
  failureMessage           String?
  observedAt               DateTime?
  submittedAt              DateTime?
  restoredAt               DateTime?
  createdAt                DateTime              @default(now())

  undoOperation UndoOperation @relation(fields: [shop, undoOperationId], references: [shop, id], onDelete: Restrict)

  @@unique([shop, undoOperationId, targetIdentity, fieldPath])
  @@unique([shop, id])
  @@index([shop, undoOperationId, outcome])
  @@index([shop, targetResourceType, targetId])
  @@index([shop, productId])
  @@index([shop, variantId])
}

model UndoCommand {
  id                  String   @id @default(cuid())
  shop                String
  undoOperationId     String
  sourceEditHistoryId String
  commandVersion      Int      @default(1)
  commandHash         String
  commandJson         Json
  payloadByteSize     Int
  payloadSchemaVersion Int @default(1)
  payloadCompression  String? @db.VarChar(24)
  payloadStorageKey   String? @db.VarChar(1024)
  retentionUntil      DateTime? @default(dbgenerated("(now() + interval '7 years')"))
  redactedAt          DateTime?
  createdAt           DateTime @default(now())

  undoOperation UndoOperation @relation(fields: [shop, undoOperationId], references: [shop, id], onDelete: Restrict)

  @@unique([shop, undoOperationId])
  @@unique([shop, commandHash])
  @@index([shop, sourceEditHistoryId])
}

model UndoOperationConflictChunk {
  id              String   @id @default(cuid())
  shop            String
  undoOperationId String
  chunkType       String
  chunkIndex      Int
  totalItems      Int      @default(0)
  payload         Json
  payloadByteSize Int
  payloadHash     String @db.Char(64)
  payloadSchemaVersion Int @default(1)
  payloadCompression String? @db.VarChar(24)
  payloadStorageKey String? @db.VarChar(1024)
  createdAt       DateTime @default(now())

  undoOperation UndoOperation @relation(fields: [shop, undoOperationId], references: [shop, id], onDelete: Restrict)

  @@unique([shop, undoOperationId, chunkType, chunkIndex])
}

