/// Transactional domain-event publication. Concrete worker enqueue commands
/// belong in OperationEnqueueIntent, not in this event stream.
model OutboxEvent {
  id               String    @id @default(cuid())
  shop             String
  aggregateType    String
  aggregateId      String
  eventType        String?
  domainEventType  String?   @map("eventType_domain")
  deduplicationKey String?
  eventDedupeKey   String?   @map("eventIdentity") @db.VarChar(512)
  payload          Json?
  payloadJson      Json?
  payloadHash      String?   @default("")
  payloadByteSize  Int       @default(0)
  payloadSchemaVersion Int   @default(1)
  payloadCompression String? @db.VarChar(24)
  payloadStorageKey String?  @db.VarChar(1024)
  status           String
  statusNormalized OutboxEventStatus @default(PENDING)
  availableAt      DateTime? @default(now())
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  publishedAt      DateTime?
  attempts         Int       @default(0)
  attemptCount     Int       @default(0)
  nextAttemptAt    DateTime  @default(now())
  lockedAt         DateTime?
  lockedBy         String?
  lockToken        String?
  lockExpiresAt    DateTime?
  fencingToken     BigInt    @default(0)
  deadLetteredAt   DateTime?
  lastErrorCode    String?
  lastErrorAt      DateTime?
  dispatchedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  retentionUntil   DateTime? @default(dbgenerated("(now() + interval '7 years')"))
  redactedAt       DateTime?

  @@unique([shop, deduplicationKey])
  @@unique([shop, eventDedupeKey], map: "OutboxEvent_shop_eventIdentity_key")
  @@unique([shop, aggregateType, aggregateId, eventType])
  @@index([status, availableAt, leaseExpiresAt, createdAt, id])
  @@index([shop, aggregateType, aggregateId, createdAt, id])
  @@index([statusNormalized, nextAttemptAt, createdAt])
  @@index([shop, statusNormalized, nextAttemptAt])
  @@index([shop, aggregateType, aggregateId])
}


