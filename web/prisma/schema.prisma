  shopifyErrorMessage    String?

  undoStatus             TargetSnapshotItemUndoStatus       @default(NOT_REQUIRED)
  undoAttemptCount       Int                                @default(0)
  lastUndoAttemptAt      DateTime?
  undoPayload            Json?
  undoErrorCode          String?
  undoErrorMessage       String?

  createdAt              DateTime                           @default(now())
  submittedAt            DateTime?
  executedAt             DateTime?
  verifiedAt             DateTime?
  undoSubmittedAt        DateTime?
  undoneAt               DateTime?

  snapshotSet            TargetSnapshotSet @relation(fields: [snapshotSetId], references: [id], onDelete: Cascade)

  @@unique([snapshotSetId, targetKey])
  @@index([shop, snapshotSetId])
  @@index([shop, operationId])
  @@index([shop, operationId, executionStatus])
  @@index([shop, operationId, undoStatus])
  @@index([shop, snapshotSetId, executionStatus])
  @@index([shop, snapshotSetId, undoStatus])
  @@index([shop, snapshotSetId, mutationGroupKey])
  @@index([shop, mirrorBatchId])
  @@index([shop, productId])
  @@index([shop, variantId])
  @@index([snapshotSetId, targetType])
}

