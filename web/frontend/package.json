    "react-redux": "^9.2.0",
    "react-router-dom": "^6.3.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "socket.io-client": "^4.8.1",
    "vite": "^5.4.0",
    "web-vitals": "^5.0.3",
    "yup": "^1.6.1",
    "zod": "^3.25.53"
