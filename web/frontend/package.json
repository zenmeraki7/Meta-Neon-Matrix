    "heroku-postbuild": "npm run build",
    "dev": "vite",
    "coverage": "vitest run --coverage",
    "lint:i18n": "eslint \"**/*.{js,jsx}\"",
    "lint": "npm run lint:i18n"
  },
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "dependencies": {
