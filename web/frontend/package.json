  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "heroku-prebuild": "npm install --include=dev",
    "build": "vite build",
    "build:analyze": "BUNDLE_ANALYZE=true vite build",
    "build:budget": "vite build && node ./scripts/checkBundleBudgets.mjs",
