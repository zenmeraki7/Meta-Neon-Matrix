    "graphql": "^16.11.0",
    "helmet": "^8.0.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "ioredis": "^5.6.0",
    "joi": "^17.13.3",
    "lodash": "^4.17.21",
    "node-cache": "^5.1.2",
    "openai": "^6.8.1",
    "pathe": "^1.1.2",
    "pdf-lib": "^1.17.1",
    "react-error-boundary": "^6.0.0",
    "react-redux": "^9.2.0",
    "redis": "^4.7.0",
