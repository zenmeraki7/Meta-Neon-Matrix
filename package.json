{
  "name": "metamatrix-embedded",
  "version": "1.0.0",
  "type": "module",
  "main": "web/Index/server.js",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "shopify": "shopify",
    "build": "cd web && npm install && npm run build",
    "start": "cd web && npm run start:web",
    "start:web": "cd web && npm run start:web",
    "start:worker": "cd web && npm run start:worker",
    "worker": "cd web && npm run worker",
    "dev": "shopify app dev",
    "info": "shopify app info",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "test:targeting-integration": "node --test web/resolveCanonicalProductTarget.integration.test.js",
    "test:failure-matrix": "node --test web/failureModeMatrix.test.js web/legacyFinalizerRetirement.contract.test.js web/webhookUndoRouting.contract.test.js web/mirrorIndexCoverage.contract.test.js web/entitlementAuthority.contract.test.js",
    "explain:targeting": "node web/scripts/explainNormalizedTargeting.js",
    "backfill:access-token-encryption": "node web/scripts/backfillAccessTokenEncryption.js",
    "backfill:target-snapshot-sets": "node web/scripts/backfillTargetSnapshotSets.js",
    "verify:target-snapshot-backfill": "node web/scripts/verifyTargetSnapshotBackfill.js",
    "test:frontend-auth-gate": "node --test web/frontend/frontendContract.auth.test.js web/frontend/domainApiFetchGate.test.js",
    "test:filter-registry-contract": "node --test web/filterRegistry.contract.test.js",
    "test:operation-lifecycle-timeline": "node --test web/frontend/operationLifecycleTimeline.test.js",
    "test:history-timeline-render": "node --test web/frontend/historyTimelineRender.contract.test.js",
    "test:perf-snapshots": "node --test web/frontend/perfProfilerSnapshot.contract.test.js",
    "test:csv-preview-cursor": "node --test web/csvPreviewCursor.contract.test.js",
    "test:worker-manifest": "node --test web/workerManifest.contract.test.js",
    "test:layer-boundary": "node --test web/layerBoundary.prismaImport.contract.test.js",
    "ci:preflight-runtime-parity": "node web/scripts/ciPreflightRuntimeParity.js",
    "test:undo-determinism-recovery": "node --test web/undoDeterminismAndRecovery.contract.test.js",
    "test:security-hardening": "node --test web/securityHardening.contract.test.js",
    "audit:naming": "node web/scripts/auditOperationalNaming.js",
    "audit:naming:update-baseline": "node web/scripts/auditOperationalNaming.js --update-baseline",
    "migrate:deploy": "cd web && npm run migrate:deploy",
    "migrate:deploy:safe": "cd web && npm run migrate:deploy:safe"
