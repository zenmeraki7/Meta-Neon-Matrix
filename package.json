    "@types/react-dom": "^19.1.5",
    "picocolors": "^1.1.1",
    "rollup": "^4.28.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^3.0.0"
